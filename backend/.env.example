# Salin ke .env lalu isi. Jangan commit .env.

# Gemini (kunci dari Google AI Studio):
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
# Nama model persis seperti di dokumentasi penyedia, misalnya gemini-3.5-flash-lite
LLM_MODEL=
# Model Gemini 3 selalu berpikir dulu; "low" membuatnya singkat supaya jawaban cepat.
LLM_REASONING_EFFORT=low
LLM_MAKS_TOKEN=2000
LLM_BATAS_DETIK=12

# Untuk Groq, ganti alamatnya dengan https://api.groq.com/openai/v1
# dan kosongkan LLM_REASONING_EFFORT kalau modelnya tidak mendukung.

# 1 = pemilihan latihan tanpa acak dan endpoint /ai/demo/isi aktif
SATU_DEMO=0
ASAL_DIIZINKAN=*
